# ─────────────────────────────────────────────────────────────
# EcoNutrients — Contact form API environment variables
# Copy this file to `.env` (local dev) or set these in your
# host's dashboard (Vercel Project Settings → Environment Variables).
# NEVER commit a real `.env` file.
# ─────────────────────────────────────────────────────────────

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Verified sender. Must be a domain/email verified in your Resend account.
# Until you verify a domain, Resend only allows sending to YOUR OWN email
# from onboarding@resend.dev. Example production value:
CONTACT_FROM_EMAIL=EcoNutrients <noreply@econutrients.in>

# Recipient of contact-form enquiries.
CONTACT_TO_EMAIL=info.econutrient@gmail.com

# Optional: lock CORS to your production origin only.
ALLOWED_ORIGIN=https://econutrients.in

# Optional: rate limiting (per IP per window).
CONTACT_RATE_LIMIT=5
CONTACT_RATE_LIMIT_WINDOW_MS=900000

# ─────────────────────────────────────────────────────────────
# Frontend (build-time, optional) — only needed if the API lives on a
# different origin than the site. Defaults to /api/contact (same origin).
# VITE_CONTACT_API_URL=https://your-function-host.com/api/contact
# ─────────────────────────────────────────────────────────────

